---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import FeaturedGrid from '../components/FeaturedGrid.astro';
import Pagination from '../components/Pagination.astro';

const PER_PAGE = 9;
const page = Number(Astro.props.page ?? 1);
const all = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = page === 1 ? all.slice(0, 3) : [];
const gridAll = all.slice(3);
const totalPages = Math.max(1, Math.ceil(gridAll.length / PER_PAGE));
const rest = gridAll.slice((page - 1) * PER_PAGE, page * PER_PAGE);
---
<BaseLayout title={page > 1 ? `Prompts de IA para desarrolladores - Página ${page}` : "Prompts de IA para desarrolladores"}>
  {page === 1 && (
  <section class="hero container">
    <div class="hero-text">
      <p class="eyebrow">inteligenciaartificialdev.com<span class="eyebrow-cursor">_</span></p>
      <h1>Prompts de IA probados<br />para quienes escriben código.</h1>
      <p class="sub">
        Artículos, tutoriales y comparativas prácticas sobre ingeniería de
        prompts y herramientas de IA: de desarrolladores, para desarrolladores.
      </p>
    </div>
  </section>
  )}

  {page === 1 && (
  <section class="container featured-wrap">
    <div class="recent-header">
      <div>
        <h2>Para leer hoy</h2>
        <span class="underline"></span>
      </div>
    </div>
    <FeaturedGrid posts={featured} />
  </section>
  )}

  <section class="container recent">
    <div class="recent-header">
      <div>
        <h2>Lo más reciente</h2>
        <span class="underline"></span>
      </div>
      <a href="/blog">Ver todos →</a>
    </div>
    <div class="grid">
      {rest.map((post) => (
        <PostCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          category={post.data.category}
          date={post.data.date}
          readingTime={post.data.readingTime}
          image={post.data.image}
          imageAlt={post.data.imageAlt}
        />
      ))}
    </div>
    <Pagination current={page} total={totalPages} />
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    padding-block: 64px 40px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    margin: 0 0 16px;
    background: linear-gradient(135deg, var(--violet), var(--rose));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .eyebrow-cursor {
    display: inline-block;
    margin-left: 2px;
    color: var(--rose);
    animation: blink 1.1s steps(1) infinite;
  }

  h1 {
    font-size: clamp(2rem, 4.5vw, 3.1rem);
    letter-spacing: -0.01em;
  }

  .sub {
    color: var(--ink-soft);
    font-size: 1.05rem;
    max-width: 44ch;
    margin-top: 20px;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .featured-wrap {
    padding-block: 32px 8px;
  }

  .recent {
    padding-block: 40px;
  }

  .recent-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
  }

  .underline {
    display: block;
    width: 48px;
    height: 4px;
    margin-top: 10px;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--violet), var(--rose));
  }

  .recent-header a {
    text-decoration: none;
    color: var(--teal);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 860px) {
    .hero {
      padding-block: 40px 24px;
    }
  }
</style>
