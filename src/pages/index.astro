---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---
<BaseLayout title="AI Prompts for Developers">
  <section class="hero container">
    <div class="hero-text">
      <p class="eyebrow">inteligenciaartificialdev.com</p>
      <h1>Tested AI prompts<br />for people who write code.</h1>
      <p class="sub">
        Articles, tutorials, and practical comparisons on prompt engineering
        and AI tools — for developers, by developers.
      </p>
    </div>
    <div class="hero-terminal" aria-hidden="true">
      <div class="terminal-bar">
        <span></span><span></span><span></span>
        <p class="terminal-filename">prompt.sh</p>
      </div>
      <pre><code>$ prompt --task "review function" \
    --language python \
    --style "safe, no regressions"

&gt; Analyzing the function... ok
&gt; 3 suggestions found
&gt; No breaking changes
$ <span class="cursor">_</span></code></pre>
    </div>
  </section>

  <section class="container recent">
    <div class="recent-header">
      <div>
        <h2>Recent articles</h2>
        <span class="underline"></span>
      </div>
      <a href="/blog">See all →</a>
    </div>
    <div class="grid">
      {posts.map((post) => (
        <PostCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          category={post.data.category}
          date={post.data.date}
          readingTime={post.data.readingTime}
          image={post.data.image}
          imageAlt={post.data.imageAlt}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
    padding-block: 64px 40px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-soft);
    margin: 0 0 16px;
  }

  h1 {
    font-size: clamp(2rem, 4.5vw, 3.1rem);
    letter-spacing: -0.01em;
  }

  .sub {
    color: var(--ink-soft);
    font-size: 1.05rem;
    max-width: 44ch;
    margin-top: 20px;
  }

  .hero-terminal {
    background: #100a1e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 24px 48px -24px rgba(91, 33, 182, 0.45);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .terminal-bar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .terminal-bar span:nth-child(1) {
    background: #ff5f56;
  }

  .terminal-bar span:nth-child(2) {
    background: #ffbd2e;
  }

  .terminal-bar span:nth-child(3) {
    background: #27c93f;
  }

  .terminal-filename {
    margin: 0 0 0 10px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .hero-terminal pre {
    min-height: 240px;
    margin: 0;
    padding: 24px;
    color: #6ee7b7;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.75;
    overflow-x: auto;
  }

  .hero-terminal .cursor {
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .recent {
    padding-block: 40px;
  }

  .recent-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
  }

  .underline {
    display: block;
    width: 48px;
    height: 4px;
    margin-top: 10px;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--violet), var(--rose));
  }

  .recent-header a {
    text-decoration: none;
    color: var(--teal);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: 40px 24px;
    }
  }
</style>
