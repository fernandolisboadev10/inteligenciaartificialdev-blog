---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

const samplePrompts = [
  {
    task: 'Explicar un error',
    prompt: 'Explícame este error como si tuviera 5 minutos antes de una reunión: [pega el error]. Dame la causa probable y la solución más directa.',
  },
  {
    task: 'Revisar una función',
    prompt: 'Revisa esta función en busca de errores, casos límite sin manejar y oportunidades de simplificación, sin cambiar su firma pública: [pega el código]',
  },
  {
    task: 'Escribir pruebas',
    prompt: 'Genera pruebas unitarias para esta función que cubran el caso feliz, un error esperado y un caso límite poco evidente: [pega el código]',
  },
  {
    task: 'Documentar una API',
    prompt: 'Escribe la documentación de esta ruta de API en formato OpenAPI, con un ejemplo de solicitud y respuesta: [pega el código de la ruta]',
  },
];
---
<BaseLayout title="Prompts gratis" description="Una muestra gratuita de prompts de IA probados para desarrolladores." noindex>
  <section class="container intro">
    <h1>Prompts gratis para desarrolladores</h1>
    <p>
      Una muestra de 4 prompts de nuestra biblioteca. Deja tu correo para
      recibir los otros 16 directamente en tu bandeja de entrada y enterarte
      cuando salgan prompts nuevos.
    </p>
    <NewsletterForm />
  </section>

  <section class="container prompts">
    {samplePrompts.map((p) => (
      <div class="prompt-card">
        <p class="task">{p.task}</p>
        <pre><code>{p.prompt}</code></pre>
      </div>
    ))}
  </section>

  <section class="container locked">
    <p class="locked-label">+ 16 prompts (requiere correo)</p>
    <p class="locked-copy">
      Depuración avanzada, refactorización segura, generación de pruebas de
      integración, prompts para revisar PR y más.
    </p>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: 56px 32px;
    max-width: 60ch;
  }

  .intro p {
    color: var(--ink-soft);
    margin: 16px 0 28px;
  }

  .prompts {
    display: grid;
    gap: 20px;
    padding-block: 24px;
  }

  .prompt-card {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 20px 24px;
    background: var(--surface);
  }

  .task {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--link-text);
    margin: 0 0 12px;
  }

  pre {
    margin: 0;
    white-space: pre-wrap;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--ink);
  }

  .locked {
    margin-block: 40px 80px;
    padding: 32px;
    border: 1px dashed var(--line);
    border-radius: 8px;
    text-align: center;
  }

  .locked-label {
    font-family: var(--font-mono);
    color: var(--ink-strong);
    font-weight: 500;
    margin: 0 0 8px;
  }

  .locked-copy {
    color: var(--ink-soft);
    margin: 0;
    max-width: 48ch;
    margin-inline: auto;
  }
</style>
