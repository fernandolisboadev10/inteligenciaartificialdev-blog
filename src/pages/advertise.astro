---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Advertise" description="Sponsorship and advertising opportunities with AI DEV.">
  <section class="container advertise">
    <h1>Advertise with AI DEV</h1>
    <div class="prose">
      <p>
        AI DEV reaches developers who actively use AI tools in their daily
        workflow — prompt engineering, AI coding assistants, and
        developer-focused tutorials. If your product or service targets that
        audience, we'd like to hear from you.
      </p>
      <p>
        We're currently exploring a small number of formats: sponsored
        newsletter mentions, display placements, and dedicated content. We
        keep placements clearly labeled and relevant to our readers.
      </p>
      <p>
        Get in touch through our <a href="/contact">contact page</a> with a
        bit about your product and what you're looking for, and we'll follow
        up.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .advertise {
    padding-block: 56px 80px;
    max-width: 68ch;
  }

  .advertise h1 {
    margin-bottom: 32px;
  }
</style>
