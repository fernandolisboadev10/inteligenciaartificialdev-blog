---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

const items = [
  'Un prompt nuevo y probado cada semana',
  'Comparativas sin rodeos de herramientas de IA para desarrolladores',
  'Aviso anticipado de nuevas guías y novedades del sitio',
];
---
<BaseLayout title="Boletín" description="Prompts y noticias de IA para desarrolladores, cada semana en tu correo.">
  <section class="container newsletter-page">
    <h1>Un prompt nuevo, cada semana.</h1>
    <p class="sub">Directo a tu correo. Sin spam, sin relleno.</p>

    <ul class="items">
      {items.map((item) => <li>{item}</li>)}
    </ul>

    <NewsletterForm />
  </section>
</BaseLayout>

<style>
  .newsletter-page {
    padding-block: 64px 96px;
    max-width: 56ch;
  }

  .sub {
    color: var(--ink-soft);
    margin: 12px 0 32px;
  }

  .items {
    list-style: none;
    padding: 0;
    margin: 0 0 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .items li {
    padding-left: 20px;
    position: relative;
    color: var(--ink-soft);
  }

  .items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 8px;
    height: 8px;
    background: var(--teal);
    border-radius: 50%;
  }
</style>
