---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import VaultCTA from '../components/VaultCTA.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  date: Date;
  readingTime?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { title, description, category, date, readingTime, image, imageAlt } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---
<BaseLayout title={title} description={description}>
  <article class="container post">
    <p class="category">{category}</p>
    <h1>{title}</h1>
    <p class="meta">{formattedDate}{readingTime && ` · ${readingTime}`}</p>

    {image && (
      <div class="hero-image">
        <Image src={image} alt={imageAlt ?? title} width={720} height={480} />
      </div>
    )}

    <div class="prose">
      <slot />
    </div>

    <VaultCTA context="Liked these prompts? The Vault has 337 more, organized by category." />
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 720px;
    padding-block: 56px;
  }

  .category {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--violet);
    margin: 0 0 12px;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-bottom: 12px;
  }

  .meta {
    color: var(--ink-soft);
    font-size: 0.9rem;
    margin: 0 0 40px;
  }

  .hero-image {
    aspect-ratio: 3 / 2;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 40px;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
