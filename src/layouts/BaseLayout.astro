---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = 'Tested AI prompts and workflows for developers.',
  image = '/images/robot-logo.png',
  type = 'website',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const siteName = 'AI DEV';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: Astro.site,
  logo: new URL('/images/robot-logo.png', Astro.site).toString(),
};
---
<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      if (storedTheme === 'dark' || storedTheme === 'light') {
        document.documentElement.setAttribute('data-theme', storedTheme);
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="google-site-verification" content="tc0GFdgefr6gTC43KdT1T9NKUEN0WiQgXQkGia164-Q" />
    <meta name="msvalidate.01" content="7F1E88061119512AF9AED1A7622C0E92" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={new URL('/rss.xml', Astro.site)} />
    <title>{title} · inteligenciaartificialdev.com</title>

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      />
    </noscript>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-80X56DDDL3"></script>
    <script is:inline>
      // Consent: EU/UK-style timezones start denied (opt-in); everywhere else starts granted (opt-out).
      // The visitor's choice is stored in localStorage under "cookie-consent".
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      (function () {
        var tz = '';
        try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
        var strict = tz.indexOf('Europe/') === 0 ||
          ['Atlantic/Canary','Atlantic/Madeira','Atlantic/Azores','Atlantic/Faroe','Atlantic/Reykjavik','Asia/Nicosia','Asia/Famagusta'].indexOf(tz) !== -1;
        var stored = null;
        try { stored = localStorage.getItem('cookie-consent'); } catch (e) {}
        var state = (stored === 'granted' || stored === 'denied') ? stored : (strict ? 'denied' : 'granted');

        gtag('consent', 'default', {
          ad_storage: state, analytics_storage: state, ad_user_data: state, ad_personalization: state
        });
        gtag('js', new Date());
        gtag('config', 'G-80X56DDDL3');

        window.siteConsent = {
          hasChoice: function () { return stored === 'granted' || stored === 'denied'; },
          set: function (value) {
            stored = value;
            try { localStorage.setItem('cookie-consent', value); } catch (e) {}
            gtag('consent', 'update', {
              ad_storage: value, analytics_storage: value, ad_user_data: value, ad_personalization: value
            });
          }
        };
      })();
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
