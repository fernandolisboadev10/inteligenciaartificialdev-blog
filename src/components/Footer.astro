---
import NewsletterForm from './NewsletterForm.astro';
import Brand from './Brand.astro';

const categories = [
  { label: 'Inicio', href: '/' },
  { label: 'Chatbots', href: '/blog?category=Chatbots' },
  { label: 'Prompts', href: '/blog?category=Prompts' },
  { label: 'Herramientas de IA', href: '/blog?category=Herramientas+de+IA' },
  { label: 'Tutoriales', href: '/blog?category=Tutoriales' },
  { label: 'Estudios de caso', href: '/blog?category=Estudios+de+caso' },
  { label: 'Carrera', href: '/blog?category=Carrera' },
];

const quickLinks = [
  { label: 'Sobre nosotros', href: '/about' },
  { label: 'Contacto', href: '/contact' },
  { label: 'Publicidad', href: '/advertise' },
  { label: 'Boletín', href: '/newsletter/' },
];
---
<footer class="site-footer">
  <div class="container grid">
    <div class="about-col">
      <Brand size={26} />
      <p class="tagline">
        AI DEV es tu guía práctica de ingeniería de prompts y herramientas de IA
        para desarrolladores. Publicamos prompts probados y comparaciones
        honestas para que construyas software más rápido con IA.
      </p>
    </div>

    <div>
      <p class="col-title">Enlaces rápidos</p>
      <ul>
        {quickLinks.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="col-title">Categorías</p>
      <ul class="cats" style={`grid-template-rows: repeat(${Math.ceil(categories.length / 2)}, auto)`}>
        {categories.map((c) => (
          <li><a href={c.href}>{c.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="col-title">Boletín</p>
      <p class="newsletter-copy">Suscríbete a nuestro boletín para recibir novedades, noticias y prompts gratis.</p>
      <NewsletterForm compact />
    </div>
  </div>

  <div class="bottom">
    <div class="container bottom-inner">
      <p>© {new Date().getFullYear()} AI DEV. Todos los derechos reservados.</p>
      <div class="legal-links">
        <a href="/privacy-policy/">Política de privacidad</a>
        <a href="/terms-of-use/">Términos de uso</a>
        <a href="#" data-open-cookie-settings>Configuración de cookies</a>
        <a href="/cookie-policy/">Política de cookies</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 80px;
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr 1.5fr 1.2fr;
    gap: 40px;
    padding-block: 52px 40px;
  }

  .about-col :global(.brand) {
    margin: 0 0 16px;
  }

  .tagline {
    color: var(--ink-soft);
    font-size: 0.9rem;
    max-width: 38ch;
    margin: 0 0 20px;
  }

  .col-title {
    margin: 0 0 18px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-strong);
  }

  .col-title::before {
    content: '// ';
    color: var(--link-text);
  }

  .newsletter-copy {
    color: var(--ink-soft);
    font-size: 0.9rem;
    margin: 0 0 16px;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  ul.cats {
    display: grid;
    grid-auto-flow: column;
    column-gap: 32px;
    row-gap: 9px;
  }

  ul a {
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.9rem;
    transition: color 0.15s ease;
  }

  ul a:hover {
    color: var(--link-text);
  }

  .bottom {
    background: var(--ink-deep);
  }

  .bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-block: 18px;
  }

  .bottom-inner p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.7);
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .legal-links a {
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.7);
  }

  .legal-links a:hover {
    color: #ffffff;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .bottom-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
