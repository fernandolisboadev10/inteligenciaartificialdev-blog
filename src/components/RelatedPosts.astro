---
import { getEntry } from 'astro:content';
import PostCard from './PostCard.astro';
import { site } from '../data/site';

interface Props {
  slugs?: string[];
}
const { slugs = [] } = Astro.props;
const entries = (await Promise.all(slugs.map((slug) => getEntry('blog', slug)))).filter(
  (entry) => entry && !entry.data.draft,
);
---
{entries.length > 0 && (
  <section class="container related" aria-labelledby="related-heading">
    <div class="sec-h"><h2 id="related-heading"><span>//</span>{site.t.related}</h2></div>
    <div class="grid">
      {entries.map((entry) => (
        <PostCard
          slug={entry!.id}
          title={entry!.data.title}
          description={entry!.data.description}
          category={entry!.data.category}
          date={entry!.data.date}
          readingTime={entry!.data.readingTime}
          image={entry!.data.image}
          imageAlt={entry!.data.imageAlt}
        />
      ))}
    </div>
  </section>
)}

<style>
  .related {
    padding-block: 48px 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
