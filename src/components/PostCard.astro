---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  readingTime?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { slug, title, description, category, readingTime, image, imageAlt } = Astro.props;
---
<a href={`/blog/${slug}`} class="card">
  {image && (
    <div class="thumb">
      <Image src={image} alt={imageAlt ?? title} width={480} height={320} />
    </div>
  )}
  <p class="category">{category}</p>
  <h3>{title}</h3>
  <p class="description">{description}</p>
  {readingTime && <p class="meta">{readingTime}</p>}
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }

  .thumb {
    aspect-ratio: 3 / 2;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 16px;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .category {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--violet);
    margin: 0 0 10px;
  }

  h3 {
    font-size: 1.3rem;
    margin-bottom: 8px;
  }

  .description {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin: 0 0 10px;
  }

  .meta {
    color: var(--ink-soft);
    font-size: 0.8rem;
    margin: 0;
  }
</style>
