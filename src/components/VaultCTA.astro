---
interface Props {
  context?: string;
}
const { context = 'Want all 337 ready-made prompts, organized by category?' } = Astro.props;
---
<aside class="vault-cta">
  <div class="text">
    <p class="eyebrow">PromptVault</p>
    <p class="context">{context}</p>
  </div>
  <a href="https://vault.inteligenciaartificialdev.com" class="button button-primary">
    See the Vault — $9.99
  </a>
</aside>

<style>
  .vault-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(225, 29, 72, 0.22), transparent 60%),
      radial-gradient(120% 140% at 100% 100%, rgba(124, 58, 237, 0.22), transparent 55%),
      #100a1e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--bg);
    padding: 28px 32px;
    border-radius: 10px;
    margin-block: 3em;
    box-shadow: 0 24px 48px -24px rgba(225, 29, 72, 0.35);
  }

  .eyebrow {
    font-family: var(--font-mono);
    color: var(--violet-soft);
    font-size: 0.8rem;
    margin: 0 0 6px;
  }

  .context {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    max-width: 40ch;
  }

  .button {
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .vault-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
