---
const categories = [
  { label: 'Chatbots', category: 'Chatbots' },
  { label: 'Prompts', category: 'Prompt Engineering' },
  { label: 'AI Tools', category: 'AI Coding Tools' },
  { label: 'Tutorials', category: 'Tutorials' },
  { label: 'Case Studies', category: 'Case Studies' },
];

const nav = [
  { label: 'Home', href: '/' },
  ...categories.map((c) => ({
    label: c.label,
    href: `/blog?category=${encodeURIComponent(c.category)}`,
  })),
  { label: 'Free Prompts', href: '/free-prompts' },
];

const currentHref = Astro.url.pathname + Astro.url.search;
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand">
      <svg class="brand-icon" width="30" height="30" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="robotGradient" x1="4" y1="4" x2="28" y2="28" gradientUnits="userSpaceOnUse">
            <stop stop-color="#7c3aed" />
            <stop offset="1" stop-color="#e11d48" />
          </linearGradient>
        </defs>
        <line x1="16" y1="6" x2="16" y2="10" stroke="url(#robotGradient)" stroke-width="2" stroke-linecap="round" />
        <circle cx="16" cy="4.5" r="2" fill="url(#robotGradient)" />
        <rect x="6" y="10" width="20" height="17" rx="6" fill="url(#robotGradient)" />
        <circle cx="12.5" cy="18.5" r="2.2" fill="var(--bg)" />
        <circle cx="19.5" cy="18.5" r="2.2" fill="var(--bg)" />
        <rect x="12" y="22.5" width="8" height="2" rx="1" fill="var(--bg)" opacity="0.85" />
      </svg>
      <span class="brand-text">
        <span class="brand-gradient">AI</span> DEV
      </span>
    </a>
    <nav class="nav">
      {nav.map((item) => (
        <a href={item.href} class:list={{ active: item.href === currentHref }}>{item.label}</a>
      ))}
    </nav>
    <div class="right-controls">
      <button type="button" class="menu-toggle" id="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-nav">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
      <span class="divider" aria-hidden="true"></span>
      <div class="search-wrap">
        <form class="search-form" action="/blog" method="get" id="search-form">
          <input type="search" name="q" placeholder="Search articles…" aria-label="Search articles" />
        </form>
        <button type="button" class="search-toggle" id="search-toggle" aria-label="Toggle search" aria-expanded="false">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </button>
      </div>
    </div>
  </div>
  <nav class="mobile-nav" id="mobile-nav">
    {nav.map((item) => (
      <a href={item.href} class:list={{ active: item.href === currentHref }}>{item.label}</a>
    ))}
  </nav>
</header>

<script>
  const searchToggle = document.getElementById('search-toggle');
  const searchWrap = document.querySelector('.search-wrap');
  const searchInput = document.querySelector<HTMLInputElement>('.search-form input');

  searchToggle?.addEventListener('click', () => {
    const open = searchWrap?.classList.toggle('open');
    searchToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) searchInput?.focus();
  });

  const menuToggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  menuToggle?.addEventListener('click', () => {
    const open = mobileNav?.classList.toggle('open');
    menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileNav.classList.remove('open');
      menuToggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand-icon {
    flex-shrink: 0;
  }

  .brand-text {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    color: var(--ink-strong);
  }

  .brand-gradient {
    background: linear-gradient(135deg, var(--violet), var(--rose));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 2px;
    flex: 1;
    justify-content: center;
  }

  .nav a {
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding: 8px 12px;
    border-radius: 20px;
    white-space: nowrap;
  }

  .nav a:hover {
    color: var(--ink-strong);
  }

  .nav a.active {
    color: var(--violet-deep);
    background: var(--line);
  }

  .right-controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--ink-strong);
    cursor: pointer;
    flex-shrink: 0;
  }

  .menu-toggle:hover {
    color: var(--violet);
  }

  .divider {
    display: none;
    width: 1px;
    height: 22px;
    background: var(--line);
  }

  .search-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .search-form {
    width: 0;
    overflow: hidden;
    opacity: 0;
    transition: width 0.2s ease, opacity 0.2s ease;
  }

  .search-wrap.open .search-form {
    width: 180px;
    opacity: 1;
  }

  .search-form input {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 20px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    background: var(--surface);
    color: var(--ink);
  }

  .search-form input:focus {
    border-color: var(--violet);
  }

  .search-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--ink-strong);
    cursor: pointer;
    flex-shrink: 0;
  }

  .search-toggle:hover {
    color: var(--violet);
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    max-height: 0;
    overflow: hidden;
    border-top: 1px solid transparent;
    transition: max-height 0.25s ease;
  }

  .mobile-nav.open {
    max-height: 480px;
    border-top-color: var(--line);
  }

  .mobile-nav a {
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink-soft);
    padding: 14px 24px;
    border-bottom: 1px solid var(--line);
  }

  .mobile-nav a.active {
    color: var(--violet-deep);
  }

  @media (max-width: 960px) {
    .nav {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .divider {
      display: block;
    }

    .mobile-nav {
      display: flex;
    }

    .search-wrap.open .search-form {
      width: 130px;
    }
  }
</style>
